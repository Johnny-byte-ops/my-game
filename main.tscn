[sub_resource type="GDScript" id="GDScript_2m5a4"]
script/source = "extends Node3D

# Preload your CharacterBody3D enemy scene
@export var enemy_scene: PackedScene = preload(\"res://Enemy.tscn\")

# Reference to the Timer node child
@onready var timer: Timer = $Timer

func _ready() -> void:
	# Connect the timer's timeout signal to our spawn function
	timer.timeout.connect(_on_timer_timeout)

func _on_timer_timeout() -> void:
	if enemy_scene:
		# 1. Create a new instance of the enemy
		var enemy_instance = enemy_scene.instantiate()
		
		# 2. Set a spawn position (Change this to fit your map layout)
		# This spawns them randomly within a 10x10 area on the XZ plane
		var random_x = randf_range(-5.0, 5.0)
		var random_z = randf_range(-5.0, 5.0)
		enemy_instance.global_position = Vector3(random_x, 1.0, random_z)
		
		# 3. Add the enemy instance into the current scene tree
		add_child(enemy_instance)
"

