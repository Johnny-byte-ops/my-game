[sub_resource type="GDScript" id="GDScript_7dm0k"]
script/source = "extends CharacterBody3D

# --- MOVEMENT SETTINGS ---
const SPEED = 7.0
const JUMP_VELOCITY = 7

# --- LOOK & SHOOT SETTINGS ---
@export var mouse_sensitivity: float = 0.003
@export var controller_sensitivity: float = 2.5 

@onready var camera: Camera3D = $Camera3D
@onready var raycast: RayCast3D = $Camera3D/RayCast3D
@onready var gun: MeshInstance3D = $Camera3D/GunMesh
@onready var flash_light: OmniLight3D = $Camera3D/GunMesh/Muzzle/OmniLight3D
@onready var flash_mesh: MeshInstance3D = $Camera3D/GunMesh/Muzzle/FlashMesh
@onready var impact_dust: CPUParticles3D = $ImpactDust 

# --- SCREEN SHAKE SETTINGS ---
@export var shake_decay: float = 5.0 
var shake_intensity: float = 0.0
var camera_default_rotation: Vector3

# --- FULL-AUTO SETTINGS ---
@export var fire_rate: float = 0.15  
var time_since_last_shot: float = 0.0
var gun_default_z: float = -0.5

# --- PLAYER HEALTH SETTINGS ---
@export var max_health: int = 100
var current_health: int = 100
@onready var health_bar: ProgressBar = $PlayerHealthBar

func _ready() -> void:
	add_to_group(\"player\")
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	
	# Wipe global score maps back to zero
	get_tree().set_meta(\"score\", 0)
	
	# --- AUTOMATIC SCREEN UI GENERATOR ---
	var ui_layer = CanvasLayer.new()
	get_parent().add_child.call_deferred(ui_layer) # Keeps UI on top screen layer
	
	var score_label = Label.new()
	score_label.text = \"Score: 0\"
	
	# Position text neatly in the top-left corner with spacing
	score_label.position = Vector2(25, 25)
	
	# Make text bigger so it's readable
	score_label.add_theme_font_size_override(\"font_size\", 32)
	
	ui_layer.add_child(score_label)
	
	# Link the spawned label to the engine metadata so the enemy can find it
	get_tree().set_meta(\"score_label\", score_label)
	
	if gun:
		gun_default_z = gun.position.z
		
	camera_default_rotation = camera.rotation

	if health_bar:
		health_bar.max_value = max_health
		health_bar.value = current_health
		
	if flash_light: flash_light.visible = false
	if flash_mesh: flash_mesh.visible = false

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed and Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		rotate_y(-event.relative.x * mouse_sensitivity)
		camera_default_rotation.x -= event.relative.y * mouse_sensitivity
		camera_default_rotation.x = clamp(camera_default_rotation.x, deg_to_rad(-89), deg_to_rad(89))

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta

	if Input.is_action_just_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

	# --- CONTROLLER LOOKING ---
	var joy_look_x = Input.get_joy_axis(0, JOY_AXIS_RIGHT_X)
	var joy_look_y = Input.get_joy_axis(0, JOY_AXIS_RIGHT_Y)
	
	if abs(joy_look_x) > 0.2:
		rotate_y(-joy_look_x * controller_sensitivity * delta)
	if abs(joy_look_y) > 0.2:
		camera_default_rotation.x -= joy_look_y * controller_sensitivity * delta
		camera_default_rotation.x = clamp(camera_default_rotation.x, deg_to_rad(-89), deg_to_rad(89))

	# --- SCREEN SHAKE LOGIC ---
	if shake_intensity > 0.001:
		shake_intensity = move_toward(shake_intensity, 0.0, shake_decay * delta)
		camera.rotation.x = camera_default_rotation.x + randf_range(-shake_intensity, shake_intensity)
		camera.rotation.y = randf_range(-shake_intensity, shake_intensity)
	else:
		camera.rotation.x = camera_default_rotation.x
		camera.rotation.y = 0.0

	# --- WEAPON TRIGGER INPUTS ---
	time_since_last_shot += delta

	var r2_pressed = Input.get_joy_axis(0, JOY_AXIS_TRIGGER_RIGHT) > 0.1
	var mouse_clicked = Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED
	
	if (r2_pressed or mouse_clicked) and time_since_last_shot >= fire_rate:
		shoot()
		time_since_last_shot = 0.0

	# --- JUMP INPUTS ---
	var jump_pressed = Input.is_action_just_pressed(\"ui_accept\") or Input.is_joy_button_pressed(0, JOY_BUTTON_A)
	if jump_pressed and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# --- MOVEMENT CONFIGURATION ---
	var input_dir := Vector2.ZERO
	if Input.is_key_pressed(KEY_W): input_dir.y -= 1
	if Input.is_key_pressed(KEY_S): input_dir.y += 1
	if Input.is_key_pressed(KEY_A): input_dir.x -= 1
	if Input.is_key_pressed(KEY_D): input_dir.x += 1
	
	var joy_move_x = Input.get_joy_axis(0, JOY_AXIS_LEFT_X)
	var joy_move_y = Input.get_joy_axis(0, JOY_AXIS_LEFT_Y)
	if abs(joy_move_x) > 0.15: input_dir.x = joy_move_x
	if abs(joy_move_y) > 0.15: input_dir.y = joy_move_y
	
	if input_dir.length() > 1.0:
		input_dir = input_dir.normalized()
	
	var direction := (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	if direction:
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	move_and_slide()

func shoot() -> void:
	var shoot_tween = create_tween().set_parallel(true)
	if flash_light: 
		flash_light.visible = true
		flash_light.light_energy = 5.0
	if flash_mesh:
		flash_mesh.visible = true
		flash_mesh.scale = Vector3.ONE
		shoot_tween.tween_property(flash_mesh, \"scale\", Vector3.ZERO, 0.04)

	if gun:
		gun.position.z = gun_default_z + 0.15
		shoot_tween.tween_property(gun, \"position:z\", gun_default_z, 0.12).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	shoot_tween.set_parallel(false) 
	shoot_tween.tween_callback(func():
		if flash_light: flash_light.visible = false
		if flash_mesh: flash_mesh.visible = false
	)

	shake_intensity = 0.03 

	if raycast and raycast.is_colliding():
		var target = raycast.get_collider()
		
		if impact_dust:
			impact_dust.global_position = raycast.get_collision_point()
			var normal = raycast.get_collision_normal()
			if normal.is_equal_approx(Vector3.UP):
				impact_dust.rotation_degrees = Vector3(-90, 0, 0)
			elif normal.is_equal_approx(Vector3.DOWN):
				impact_dust.rotation_degrees = Vector3(90, 0, 0)
			else:
				impact_dust.look_at(raycast.get_collision_point() + normal, Vector3.UP)
			impact_dust.restart()

		if target.has_method(\"take_damage\"):
			target.take_damage(1)

func take_damage(amount: int) -> void:
	current_health -= amount
	if health_bar:
		health_bar.value = current_health
	if current_health <= 0:
		die()

func die() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	get_tree().reload_current_scene()
"

